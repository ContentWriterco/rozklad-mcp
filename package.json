{
  "name": "rozklad-mcp",
  "version": "0.1.0",
  "description": "MCP server with Polish public transport timetables: all trains (PKP Intercity, Polregio, Koleje Mazowieckie, ...), PKS buses and city transit. Journey planning with changes, departures and live delays for AI agents. No API key needed.",
  "type": "module",
  "bin": {
    "rozklad-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "feeds",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/unit.test.mjs test/engine.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check-feeds": "node scripts/check-feeds.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pkp",
    "pks",
    "rozklad-jazdy",
    "gtfs",
    "poland",
    "trains",
    "public-transport",
    "ai-agent",
    "claude",
    "intercity",
    "polregio"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fflate": "^0.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContentWriterco/rozklad-mcp.git"
  },
  "homepage": "https://github.com/ContentWriterco/rozklad-mcp#readme",
  "bugs": {
    "url": "https://github.com/ContentWriterco/rozklad-mcp/issues"
  },
  "mcpName": "io.github.ContentWriterco/rozklad-mcp"
}
